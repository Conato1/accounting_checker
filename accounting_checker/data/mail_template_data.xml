<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_audit_alert" model="mail.template">
            <field name="name">Audit Alert: Issues Detected</field>
            <field name="model_id" ref="model_accounting_audit"/>
            <field name="subject">WARNING: {{ object.error_count }} Issues found in Accounting Data ({{ object.name }})</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear Accounting Manager,
                        <br/><br/>
                        The automated <strong>Data Integrity Checker</strong> has completed its daily scan.
                        <br/>
                        <span style="color: red; font-weight: bold; font-size: 16px;">
                            CRITICAL ALERT: <t t-out="object.error_count"/> issues were detected.
                        </span>
                        <br/><br/>
                        <strong>Audit Summary:</strong>
                        <ul>
                            <li>Reference: <t t-out="object.name"/></li>
                            <li>Date: <t t-out="object.date_audit"/></li>
                            <li>Health Score: <t t-out="object.integrity_score"/>%</li>
                        </ul>
                        <br/>
                        Please login to Odoo and check the <strong>Audit &amp; Compliance</strong> menu immediately to resolve these discrepancies.
                        <br/><br/>
                        <div style="text-align: center; margin-top: 16px;">
                            <a t-att-href="object.get_base_url() + '/web#id=' + str(object.id) + '&amp;model=accounting.audit&amp;view_type=form'"
                               style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                View Audit Report
                            </a>
                        </div>
                        <br/><br/>
                        Regards,
                        <br/>
                        Odoo Automation System
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>